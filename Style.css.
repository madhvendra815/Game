* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #ff758c, #ff7eb3, #8e44ad);
  color: white;
  text-align: center;
  overflow-x: hidden;
}

.container {
  width: 90%;
  max-width: 650px;
  margin: auto;
  padding: 50px 20px;
}

h1 {
  font-size: 42px;
  text-shadow: 0 5px 15px rgba(0,0,0,0.3);
  animation: glow 2s infinite alternate;
}

h2 {
  font-size: 38px;
  margin: 10px 0;
}

.subtitle {
  font-size: 20px;
  margin: 15px 0 25px;
}

.cake {
  font-size: 110px;
  animation: bounce 1.5s infinite;
  margin: 20px;
}

button {
  border: none;
  padding: 14px 25px;
  margin: 10px;
  border-radius: 30px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  background: white;
  color: #8e44ad;
  box-shadow: 0 8px 20px rgba(0,0,0,0.25);
  transition: 0.3s;
}

button:hover {
  transform: scale(1.1);
  box-shadow: 0 12px 25px rgba(0,0,0,0.35);
}

.game {
  margin-top: 35px;
  padding: 30px 20px;
  border-radius: 25px;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
}

.game h3 {
  font-size: 28px;
  margin-bottom: 15px;
}

.buttons {
  margin-top: 20px;
}

#message {
  min-height: 30px;
  margin: 15px;
  font-size: 20px;
  font-weight: bold;
}

.wish {
  font-size: 20px;
  line-height: 1.6;
  margin: 20px;
}

.hidden {
  display: none;
}

footer {
  margin-top: 50px;
  font-size: 14px;
  opacity: 0.9;
}

.balloons span {
  position: fixed;
  bottom: -100px;
  font-size: 55px;
  animation: float 8s linear infinite;
}

.balloons span:nth-child(1) {
  left: 5%;
  animation-delay: 0s;
}

.balloons span:nth-child(2) {
  left: 25%;
  animation-delay: 2s;
}

.balloons span:nth-child(3) {
  left: 50%;
  animation-delay: 4s;
}

.balloons span:nth-child(4) {
  left: 70%;
  animation-delay: 1s;
}

.balloons span:nth-child(5) {
  left: 90%;
  animation-delay: 3s;
}

@keyframes float {
  0% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-60vh) rotate(15deg);
  }

  100% {
    transform: translateY(-120vh) rotate(-15deg);
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-15px);
  }
}

@keyframes glow {
  from {
    text-shadow: 0 0 10px white;
  }

  to {
    text-shadow: 0 0 30px yellow;
  }
}

@media (max-width: 600px) {
  h1 {
    font-size: 30px;
  }

  h2 {
    font-size: 30px;
  }

  .cake {
    font-size: 80px;
  }
  }
